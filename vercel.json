{
  "rewrites": [
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/privacidade/",
      "destination": "/privacidade.html"
    }
  ],
  "headers": [
    {
      "source": "/privacidade",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/privacidade.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}